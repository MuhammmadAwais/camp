# ==============================================================================
# AutoNexa / CAMP — Environment Variables Template
# Copy to `.env.local` (or `.env`) and fill in environment-specific values.
# NEVER commit `.env` or `.env.local` with real secrets.
# ==============================================================================

# --- Supabase (Core Database, Auth, Realtime & Storage) ---
# TODO(senior-review): Provision production Supabase in AWS ca-central-1 (Montreal)
# to satisfy PIPEDA & Quebec Law 25 Canadian data residency (SRS NFR-09).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# Optional legacy fallback if using older anon/service_role keys:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only secret key (NEVER expose via NEXT_PUBLIC_ or client imports)
SUPABASE_SECRET_KEY="sb_secret_xxx"
# Optional legacy fallback:
# SUPABASE_SERVICE_ROLE_KEY=""

# --- App & Feature Flags ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ENABLE_MOCK_API="false"
STORAGE_DRIVER="supabase"
KYC_MODE="sandbox"

# --- Demo / Preview Safety Flags (MUST be false or unset in Production) ---
ALLOW_DEMO_AUTH="false"
ENABLE_DEMO_SWITCH="false"
# DEMO_ACCOUNT_PASSWORD=""

# --- Stripe Billing (CAD Subscriptions — Phase B7) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Email & SMS Adapters (CASL Compliant — Phase B7) ---
SENDGRID_API_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="AutoNexa <noreply@autonexa.ca>"
CASL_UNSUBSCRIBE_SECRET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Rate Limiting (Upstash Redis — Phase B8; in-memory fallback in dev) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Optional AWS S3 Direct Storage Adapter (ca-central-1 — Phase B8) ---
AWS_REGION="ca-central-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_CLOUDFRONT_URL=""

# --- Optional External Geo Provider ---
# GOOGLE_MAPS_API_KEY=""
